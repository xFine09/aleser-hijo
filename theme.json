{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "arena", "name": "Arena", "color": "#FAF7F2" },
				{ "slug": "tinta", "name": "Tinta", "color": "#1F2A37" },
				{ "slug": "mar", "name": "Azul mar", "color": "#0B5C8A" },
				{ "slug": "coral", "name": "Coral", "color": "#E4572E" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "titulos",
					"name": "Títulos (Georgia)",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--arena)",
			"text": "var(--wp--preset--color--tinta)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--mar)" },
				":hover": { "color": { "text": "var(--wp--preset--color--coral)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--mar)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--titulos)" }
			}
		}
	}
}
